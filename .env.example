# Copy to .env and fill in real values before `docker compose up`.

# --- Public hostname & TLS ---
DOMAIN=santa.example.org
ACME_EMAIL=admin@example.org

# --- Django ---
DJANGO_SECRET_KEY=replace-me-with-50-random-bytes
DJANGO_LOG_LEVEL=INFO

# --- Santa sync ---
SANTA_SYNC_TOKEN=replace-with-token-shared-with-santa-clients
SANTA_DEFAULT_CLIENT_MODE=MONITOR
SANTA_DEFAULT_BATCH_SIZE=50
SANTA_FULL_SYNC_INTERVAL_SECONDS=600

# --- Postgres ---
POSTGRES_DB=elf
POSTGRES_USER=elf
POSTGRES_PASSWORD=replace-me
