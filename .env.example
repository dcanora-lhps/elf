# Copy to .env and fill in real values before `docker compose up`.

# --- Public hostname & TLS ---
DOMAIN=santa.example.org
ACME_EMAIL=admin@example.org

# --- Django ---
DJANGO_SECRET_KEY=replace-me-with-50-random-bytes
DJANGO_LOG_LEVEL=INFO

# --- Santa sync ---
SANTA_SYNC_TOKEN=replace-with-token-shared-with-santa-clients
SANTA_DEFAULT_CLIENT_MODE=MONITOR
SANTA_DEFAULT_BATCH_SIZE=50
SANTA_FULL_SYNC_INTERVAL_SECONDS=600

# --- Sync session retention (nightly `purge` service) ---
# Sessions older than this many days are deleted each night. The machine page
# only ever shows the 50 most recent, so this is a forensics window, not a
# functional one. At the default 10-minute sync interval each machine writes
# ~144 sessions/day, so 30 days retains ~4,300 rows per machine.
PURGE_RETENTION_DAYS=30
PURGE_AT=03:15
TZ=UTC

# --- Postgres ---
POSTGRES_DB=elf
POSTGRES_USER=elf
POSTGRES_PASSWORD=replace-me
