# Copy to .env and fill in real values before `docker compose up`.

# --- Django ---
DJANGO_SECRET_KEY=replace-me-with-50-random-bytes
DJANGO_ALLOWED_HOSTS=santa.example.org,santa.internal.example.org
DJANGO_CSRF_TRUSTED_ORIGINS=https://santa.example.org
DJANGO_BEHIND_PROXY=1
DJANGO_LOG_LEVEL=INFO

# --- Santa sync ---
SANTA_SYNC_TOKEN=replace-with-token-shared-with-santa-clients
SANTA_DEFAULT_CLIENT_MODE=MONITOR
SANTA_DEFAULT_BATCH_SIZE=50
SANTA_FULL_SYNC_INTERVAL_SECONDS=600

# --- Postgres ---
POSTGRES_DB=elf
POSTGRES_USER=elf
POSTGRES_PASSWORD=replace-me

# --- Host binding ---
# Default binds gunicorn to localhost only — put TLS terminator on the same host.
# Set HOST_BIND=0.0.0.0 if your reverse proxy is on a different host.
HOST_BIND=127.0.0.1
HOST_PORT=8000
